#include <tunables/global>

# AppArmor profile for nginx running in Docker
# Load with: sudo apparmor_parser -r /etc/apparmor.d/docker-nginx
# Use with:  docker run --security-opt apparmor=docker-nginx nginx

profile docker-nginx flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # ===== Network Access =====
  network inet tcp,
  network inet udp,
  network inet6 tcp,
  network inet6 udp,

  # ===== Nginx Binary =====
  /usr/sbin/nginx ix,
  /usr/bin/nginx ix,

  # ===== Nginx Configuration =====
  /etc/nginx/** r,
  /etc/nginx/conf.d/** r,

  # ===== Web Content (read-only) =====
  /usr/share/nginx/** r,
  /var/www/** r,

  # ===== Logs =====
  /var/log/nginx/** rw,
  /var/log/nginx/ r,

  # ===== Cache and Runtime =====
  /var/cache/nginx/** rw,
  /var/cache/nginx/ rw,
  /run/nginx.pid rw,
  /tmp/** rw,

  # ===== SSL/TLS Certificates =====
  /etc/ssl/** r,
  /etc/pki/** r,

  # ===== System Libraries =====
  /lib/** r,
  /usr/lib/** r,
  /lib64/** r,

  # ===== Proc filesystem (limited) =====
  /proc/sys/net/** r,
  owner /proc/*/fd/ r,
  owner /proc/*/status r,

  # ===== DENY Rules =====
  # Sensitive files
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/sudoers r,
  deny /etc/sudoers.d/** r,

  # Home directories
  deny /root/** rwx,
  deny /home/** rwx,

  # Dangerous proc entries
  deny /proc/*/mem r,
  deny /proc/kcore r,
  deny /proc/sysrq-trigger w,

  # System modification
  deny /sys/** w,
  deny /boot/** rwx,

  # Dangerous operations
  deny mount,
  deny umount,
  deny ptrace,
  deny signal peer=unconfined,
}

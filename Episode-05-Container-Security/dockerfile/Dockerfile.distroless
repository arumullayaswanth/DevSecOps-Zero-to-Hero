# ✅ DISTROLESS Dockerfile — Minimal attack surface
# Uses Google's distroless image: no shell, no package manager, no OS tools

# Stage 1: Build
FROM golang:1.21 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -installsuffix cgo -ldflags="-w -s" -o /app/myapp .

# Stage 2: Distroless runtime
FROM gcr.io/distroless/static-debian12

# Copy binary from builder
COPY --from=builder /app/myapp /myapp

# Run as non-root (distroless provides 'nonroot' user)
USER nonroot:nonroot

EXPOSE 8080

ENTRYPOINT ["/myapp"]
